# Copier ce fichier en .env (non versionne) puis adapter
JWT_SECRET=smtg-quiz-application-secret-key-2026-very-long-and-secure-key-for-jwt-hmac-sha256
USER_SERVICE_INTERNAL_TOKEN=replace-with-a-long-random-secret
APP_PUBLIC_URL=http://localhost:8765
GMAIL_USERNAME=votre.adresse@gmail.com
# Mot de passe d'application Gmail (16 caracteres sans espaces), pas le mot de passe du compte. Vide = aucun e-mail envoye.
GMAIL_APP_PASSWORD=
